# LibreChat settings for the Etus Design e2e suite. Only test values: the random secrets
# (CREDS_KEY, CREDS_IV, JWT_SECRET, JWT_REFRESH_SECRET, OPENID_SESSION_SECRET) are generated
# by the init service on every run and loaded by services/chat-entrypoint.sh.

# Public address of the chat as the browsers see it (TLS ends at the edge, as Cloudflare does).
HOST=0.0.0.0
PORT=3080
NODE_ENV=production
DOMAIN_CLIENT=https://chat.etus.test
DOMAIN_SERVER=https://chat.etus.test
TRUST_PROXY=1
MONGO_URI=mongodb://mongodb:27017/LibreChat
CONFIG_PATH=/app/librechat.yaml
NO_INDEX=true
SEARCH=false
USE_REDIS=false
TITLE_CONVO=false
NODE_EXTRA_CA_CERTS=/certs/ca.crt

# Login only through OpenID (the fake Logto in services/fake-idp-hub.mjs), like production.
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
OPENID_ISSUER=https://idp.etus.test
OPENID_CLIENT_ID=chat-e2e
OPENID_CLIENT_SECRET=e2e-oidc-client-secret
OPENID_SCOPE="openid profile email offline_access"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL=Etus
OPENID_REUSE_TOKENS=true
OPENID_USE_PKCE=true

# Rate limits raised: the suite logs in many times from the same address (lesson of C7).
LOGIN_MAX=1000
LOGIN_WINDOW=1
REGISTER_MAX=1000
CONCURRENT_MESSAGE_MAX=10
MESSAGE_IP_MAX=1000
MESSAGE_USER_MAX=1000

# Design proxy: the hub is the fake one behind the edge; the key is a test string.
ETUS_DESIGN_URL=http://design-service:8080
ETUS_HUB_URL=https://hub.etus.test
ETUS_HUB_MCP_KEY=e2e-chat-mcp-key

# Fake model (services/fake-llm.mjs) used by the custom endpoint of librechat.e2e.yaml.
FAKE_LLM_KEY=e2e-fake-llm
